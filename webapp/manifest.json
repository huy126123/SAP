{
  "_version": "1.58.0",
  "sap.app": {
    "id": "sap.ui.demo.productmanager",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "productData": {
        "uri": "model/data.json",
        "type": "JSON"
      }
    },
    "crossNavigation": {
      "inbounds": {
        "Product-manage": {
          "semanticObject": "Product",
          "action": "manage",
          "title": "{{flpTitle}}",
          "subTitle": "{{flpSubTitle}}",
          "icon": "sap-icon://product",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.cloud": {
    "service": "sapui5fiorimanager.service",
    "public": true
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://product",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "rootView": {
      "viewName": "sap.ui.demo.productmanager.view.App",
      "type": "XML",
      "async": true,
      "id": "App"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.f": {},
        "sap.ui.layout": {},
        "sap.ui.table": {},
        "sap.ushell": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "sap.ui.demo.productmanager.i18n.i18n",
          "supportedLocales": [
            "en",
            ""
          ],
          "fallbackLocale": "en"
        }
      },
      "": {
        "type": "sap.ui.model.json.JSONModel",
        "dataSource": "productData"
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "sap.ui.demo.productmanager.view",
        "controlId": "app",
        "controlAggregation": "pages"
      },
      "routes": [
        {
          "name": "ProductList",
          "pattern": "",
          "target": [
            "ProductList"
          ]
        }
      ],
      "targets": {
        "ProductList": {
          "viewName": "ProductList",
          "viewLevel": 1
        }
      }
    }
  }
}
